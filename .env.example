# Copie ce fichier en `.env` (cp .env.example .env) puis complète les valeurs.
# Le fichier .env n'est jamais versionné dans git.

# Chemin vers la clé de service Google Cloud (fichier JSON téléchargé depuis GCP,
# à déposer dans le dossier secrets/ — voir README, étape 4)
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-vision-key.json

# Supabase (utilisé en phase 2 pour l'upload des photos — laisser vide pour l'instant)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
